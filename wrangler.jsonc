{
  // Cloudflare Workers Static Assets configuration for VertigoLab
  "name": "vertigolab",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "."
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
